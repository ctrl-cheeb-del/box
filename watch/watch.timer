[Unit]
Description=Run watch every 15 min; each creator is due every 3h from when it was added

[Timer]
# Counted from when the user manager starts, not from boot: after a restart of the user manager
# (jarvis, 2026-10-15) OnBootSec had long passed and OnUnitActiveSec had no run to count from,
# so the timer sat "elapsed" for two weeks.
OnStartupSec=5min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
