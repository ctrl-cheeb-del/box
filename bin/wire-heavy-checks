#!/usr/bin/env python3
"""Wrap a project's heavy package scripts. Print the diff unless --apply is set."""
import argparse
import difflib
import json
from pathlib import Path
import re

HELPER = '''#!/bin/sh
# Installed by box/bin/wire-heavy-checks. Queue when available;
# other developer machines and CI keep the original behavior.
if command -v heavy-check >/dev/null 2>&1; then
  exec heavy-check run -- "$@"
fi
exec "$@"
'''


def wire(root, apply=False):
    package = root / "package.json"
    before = package.read_text()
    data = json.loads(before)
    after = before
    for name in ("check", "typecheck", "typecheck:scripts", "test", "build"):
        original = data.get("scripts", {}).get(name)
        if original is None:
            continue
        raw = "heavy:raw:" + name
        wrapper = f"sh scripts/heavy-check.sh bun run {raw}"
        if original == wrapper:
            if raw not in data["scripts"]:
                raise ValueError(f"missing original script: {raw}")
            continue
        if raw in data["scripts"]:
            raise ValueError(f"refusing to overwrite existing {raw}")
        pattern = re.compile(r'^(\s*)' + re.escape(json.dumps(name)) + r':\s*' + re.escape(json.dumps(original)) + r'(,?)$', re.M)
        def replacement(match):
            indent, comma = match.groups()
            return f'{indent}{json.dumps(name)}: {json.dumps(wrapper)},\n{indent}{json.dumps(raw)}: {json.dumps(original)}{comma}'
        after, count = pattern.subn(replacement, after)
        if count != 1:
            raise ValueError(f"expected exactly one script line for {name}, found {count}")
    json.loads(after)
    helper = root / "scripts/heavy-check.sh"
    if helper.exists() and helper.read_text() != HELPER:
        raise ValueError(f"refusing to overwrite {helper}")
    print("".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
                                       fromfile=str(package), tofile=str(package))), end="")
    if apply:
        helper.parent.mkdir(exist_ok=True)
        helper.write_text(HELPER)
        helper.chmod(0o755)
        package.write_text(after)
    elif not helper.exists():
        print(f"Would create {helper}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("project", type=Path)
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    wire(args.project.resolve(), args.apply)
