#!/bin/zsh
# box — drive Art's machines (the agent boxes and the Mac) from any one of them.
# Machines are listed in ../machines; the "default" one is used when none is named.
# Every command tries the home network first, then Tailscale (starting it on the Mac if needed).

USER_NAME="art"
PROXY_LOCAL_PORT=24874
CONF_DIR="$HOME/.config/agentbox"
MACHINES_FILE="${BOX_MACHINES:-${0:A:h}/../machines}"
# This repo (skills/, mac/); absent when the launchd shadow copy runs.
BOX_REPO=${0:A:h:h}
# Background jobs (launchd) can't read ~/Documents, so keep a runnable copy outside it.
SHADOW="$HOME/.local/share/box"
if [[ ${0:A} == */bin/box && -r ${0:A:h}/../machines ]]; then
  mkdir -p "$SHADOW"
  cmp -s "${0:A}" "$SHADOW/box" || cp "${0:A}" "$SHADOW/box"
  cmp -s "${0:A:h}/../machines" "$SHADOW/machines" || cp "${0:A:h}/../machines" "$SHADOW/machines"
fi
TS="/usr/local/bin/tailscale"
[[ $OSTYPE == darwin* ]] && ON_MAC=1 || ON_MAC=0

typeset -A M_LAN M_TS M_ROLES M_USER
M_NAMES=()
while read -r name lan ts roles user _; do
  [[ -z $name || $name == \#* ]] && continue
  M_NAMES+=($name); M_LAN[$name]=$lan; M_TS[$name]=$ts; M_ROLES[$name]=$roles; M_USER[$name]=${user:-$USER_NAME}
done < "$MACHINES_FILE"

has_role() { [[ ",${M_ROLES[$1]}," == *",$2,"* ]]; }
# Machines that "all" and the syncs go through: everything except Windows PCs, which are SSH-only.
FLEET=(); for _n in $M_NAMES; do has_role $_n windows || FLEET+=($_n); done; unset _n
machine_with_role() { local n; for n in $M_NAMES; do has_role $n $1 && { echo $n; return; }; done; }
is_machine() { (( ${M_NAMES[(Ie)$1]} )); }
# Agent boxes that run macOS ("macbox"): launchd instead of systemd, no Ubuntu services.
on_macos() { has_role $1 mac || has_role $1 macbox; }
# The machine this is running on: matched by hostname, else the "mac" role on macOS.
SELF=${${(L)$(hostname -s)}}
is_machine $SELF || { (( ON_MAC )) && SELF=$(machine_with_role mac) || SELF=""; }
# revnu2's Claude memory folder, relative to home; Claude names it after the checkout path.
memory_dir() { on_macos $1 && echo .claude/projects/-Users-art-Documents-projects-revnu2/memory/ \
  || echo .claude/projects/-home-art-Documents-projects-revnu2/memory/; }

TARGET=""
say() { print -P "%F{cyan}${TARGET:-box}%f $*" >&2; }

if (( ON_MAC )); then reachable() { nc -z -G "${3:-2}" "$1" "$2" >/dev/null 2>&1; }
else reachable() { nc -z -w "${3:-2}" "$1" "$2" >/dev/null 2>&1; }; fi

# Prints the address to use for $TARGET ("self" for this machine); starts Tailscale when the home network fails.
resolve() {
  local port=${1:-22} lan=${M_LAN[$TARGET]} ts=${M_TS[$TARGET]}
  [[ $TARGET == $SELF ]] && { echo self; return; }
  if reachable "$lan" "$port"; then echo "$lan"; return; fi
  [[ -z $ts || $ts == - ]] && { say "can't reach $lan. Is it on?"; return 1; }
  if reachable "$ts" "$port"; then say "via Tailscale"; echo "$ts"; return; fi
  (( ON_MAC )) || { say "can't reach $TARGET (home network or Tailscale). Is it on?"; return 1; }
  [[ -n ${BOX_NO_TS_START:-} ]] && { say "not reachable without starting Tailscale, skipped"; return 1; }
  say "not on home network, starting Tailscale..."
  pgrep -xq Tailscale || open -ga Tailscale
  sleep 2
  "$TS" up >/dev/null 2>&1
  for _ in {1..15}; do
    if reachable "$ts" "$port"; then say "via Tailscale"; echo "$ts"; return; fi
    sleep 1
  done
  say "can't reach $TARGET (home network or Tailscale). Is it on?"
  return 1
}

# on <host> <cmd...>: run on a resolved host, locally when it's this machine. `ont` gives it a terminal.
on()  { local h=$1; shift; [[ $h == self ]] && { bash -c "$*"; return; }; ssh -T -o BatchMode=yes "${M_USER[$TARGET]:-$USER_NAME}@$h" "$@"; }
ont() { local h=$1; shift; [[ $h == self ]] && { bash -c "$*"; return; }; ssh -t "${M_USER[$TARGET]:-$USER_NAME}@$h" "$@"; }

run() { local h; h=$(resolve) || return 1; on "$h" "$@"; }

# Commands that drive an agent box's services; the Mac has none of them.
need_box() {
  has_role $TARGET mac && { say "is the Mac; \`box $1\` is for the agent boxes"; return 1; }
  has_role $TARGET windows && { say "is a Windows PC; \`box $1\` is for the agent boxes"; return 1; }
  return 0
}
# Commands that open a window or the clipboard on this computer.
need_mac() { (( ON_MAC )) && return; say "\`box $1\` opens a window, so run it from the Mac"; return 1; }

need_role() {
  has_role $TARGET $1 && return
  say "$2 $(machine_with_role $1): use \`box $3\`"
  return 1
}

cmd_list() {
  local n where
  printf "%-10s %-24s %-17s %-16s %s\n" MACHINE LAN TAILSCALE ROLES NOW
  for n in $M_NAMES; do
    if [[ $n == $SELF ]]; then where="this machine"
    elif reachable "${M_LAN[$n]}" 22 1; then where="home network"
    elif [[ ${M_TS[$n]} != - ]] && reachable "${M_TS[$n]}" 22 1; then where="via Tailscale"
    else where="unreachable"; fi
    printf "%-10s %-24s %-17s %-16s %s\n" $n ${M_LAN[$n]} ${M_TS[$n]} ${M_ROLES[$n]} "$where"
  done
}

cmd_ssh() {
  local h; h=$(resolve) || return 1
  [[ $h == self ]] && { say "is this machine"; return; }
  has_role $TARGET mac && { ssh -t "$USER_NAME@$h"; return; }
  has_role $TARGET windows && { ssh -t "${M_USER[$TARGET]}@$h"; return; }
  # tmux keeps the shell alive if the connection drops; reattach with `box` again.
  ssh -t "$USER_NAME@$h" 'tmux new -A -s main'
}

# FreeRDP by default: the Windows App dropped every session after ~1 min against GNOME's RDP
# server (0x200d), FreeRDP held. Password comes from the Keychain item "agentbox-rdp"; a Windows PC
# has its own Windows password, in "box-rdp-<machine>".
cmd_desktop() {
  need_mac desktop || return 1
  has_role $TARGET windows || need_box desktop || return 1
  # A macOS box: Screen Sharing (VNC), which asks for the login password and can keep it in Keychain.
  if has_role $TARGET macbox; then
    local h; h=$(resolve 5900) || return 1
    open "vnc://${M_USER[$TARGET]}@$h"; say "opening Screen Sharing"; return
  fi
  [[ $1 == --windows-app ]] && { cmd_desktop_windows_app; return; }
  local h pw user=${M_USER[$TARGET]} item=agentbox-rdp
  has_role $TARGET windows && item=box-rdp-$TARGET
  h=$(resolve 3389) || return 1
  pw=$(security find-generic-password -a "$user" -s $item -w 2>/dev/null) || {
    say "no password in Keychain; add it with: security add-generic-password -a $user -s $item -w"
    return 1
  }
  nohup /opt/homebrew/bin/sdl-freerdp "/v:$h" "/u:$user" "/p:$pw" /cert:ignore \
    /dynamic-resolution /size:1600x1000 +clipboard /audio-mode:2 \
    +auto-reconnect /auto-reconnect-max-retries:50 /log-level:ERROR \
    >"$CONF_DIR/freerdp-$TARGET.log" 2>&1 &!
  say "opening desktop (FreeRDP); log: $CONF_DIR/freerdp-$TARGET.log"
}

cmd_desktop_windows_app() {
  local h; h=$(resolve 3389) || return 1
  local rdp="$CONF_DIR/$TARGET.rdp"
  cat > "$rdp" <<EOF
full address:s:$h
username:s:$USER_NAME
prompt for credentials on client:i:0
screen mode id:i:2
dynamic resolution:i:1
session bpp:i:16
use multimon:i:0
use redirection server name:i:1
audiomode:i:2
EOF
  open -a "Windows App" "$rdp"
}

cmd_proxy() {
  need_mac proxy || return 1
  need_role proxy "the Claude proxy lives on" proxy || return 1
  local h; h=$(resolve) || return 1
  if ! reachable localhost "$PROXY_LOCAL_PORT"; then
    ssh -f -N -o ExitOnForwardFailure=yes -L "${PROXY_LOCAL_PORT}:localhost:24873" "$USER_NAME@$h" || return 1
  fi
  on "$h" 'cat ~/.cli-proxy-api/management-key' | tr -d '\n' | pbcopy
  say "management key copied to clipboard"
  open "http://localhost:$PROXY_LOCAL_PORT/management.html"
}

# 5-hour and weekly use per Claude account, from the rate-limit headers the proxy last saw.
cmd_usage() {
  need_role proxy "Claude accounts live on" usage || return 1
  local h; h=$(resolve) || return 1
  on "$h" 'bash -s' <<'EOF'
K=$(cat ~/.cli-proxy-api/management-key)
curl -s -H "Authorization: Bearer $K" http://127.0.0.1:24873/v0/management/auth-files | jq -r '
  def when: (tonumber - now) as $s | if $s <= 0 then "now" elif $s < 86400 then "in \(($s/3600)|floor)h\((($s%3600)/60)|floor)m" else "in \(($s/86400)|floor)d\((($s%86400)/3600)|floor)h" end;
  def pct: ((tonumber * 100) | round | tostring) + "%";
  ["ACCOUNT", "5H USED", "5H RESETS", "WEEK USED", "WEEK RESETS", "SEEN"],
  (.files[] | . as $f
   | ([.model_quotas // {} | to_entries[] | .value] | sort_by(.observed_at) | last) as $q
   | if $q == null then [$f.email, "-", "-", "-", "-", "no traffic yet"]
     else ($q.signals) as $s
     | [$f.email, ($s["Anthropic-Ratelimit-Unified-5h-Utilization"] // "0" | pct), ($s["Anthropic-Ratelimit-Unified-5h-Reset"] | when),
        ($s["Anthropic-Ratelimit-Unified-7d-Utilization"] // "0" | pct), ($s["Anthropic-Ratelimit-Unified-7d-Reset"] | when),
        ($q.observed_at[11:16])] end)
  | @tsv' | column -t -s $'\t'
EOF
  say "as last seen by the proxy; an account with no recent traffic shows its last known numbers"
}

cmd_proxy_close() { pkill -f "ssh -f -N -o ExitOnForwardFailure=yes -L $PROXY_LOCAL_PORT" && say "proxy tunnel closed"; }

cmd_status() {
  local h; h=$(resolve) || return 1
  case $h in self) say "this machine" ;; ${M_LAN[$TARGET]}) say "reachable on home network" ;; *) say "reachable via Tailscale" ;; esac
  has_role $TARGET windows && { say "Windows PC, SSH only: no services to check"; return; }
  if has_role $TARGET mac; then
    on "$h" 'bash -s' <<'EOF'
echo "uptime      $(uptime | sed "s/.*up \([^,]*\),.*/\1/")"
echo "macOS       $(sw_vers -productVersion)"
echo "battery     $(pmset -g batt | grep -o "[0-9]*%.*;" | head -1)"
echo "disk        $(df -h / | awk 'NR==2{print $3" used / "$2}')"
EOF
    return
  fi
  if has_role $TARGET macbox; then
    # macOS ships bash 3.2: keep this script free of bash 4 features.
    on "$h" 'bash -s' <<'EOF'
ok() { [ "$1" = active ] && printf "\e[32m%s\e[0m" "$1" || printf "\e[31m%s\e[0m" "$1"; }
echo "uptime      $(uptime | sed "s/.*up \([^,]*\),.*/\1/")"
t3=$(launchctl print gui/$(id -u)/com.t3tools.t3code.service 2>/dev/null | awk '$1 == "state" {print $3; exit}')
[ "$t3" = running ] && t3=active
echo "t3 code     $(ok "${t3:-not installed}")"
base=$(jq -r ".env.ANTHROPIC_BASE_URL // empty" ~/.claude/settings.json 2>/dev/null)
code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "$base/v1/models" -H "x-api-key: $(cat ~/.cli-proxy-api/proxy-key 2>/dev/null)")
[ "$code" = 200 ] && st=active || st="unreachable ($code)"
echo "claude via  $base $(ok "$st")"
/Applications/Tailscale.app/Contents/MacOS/Tailscale status --self --peers=false >/dev/null 2>&1 && ts=active || ts=down
echo "tailscale   $(ok $ts)"
echo "t3 connect  $(t3 connect status 2>/dev/null | grep -E 'Exposure' | sed 's/.*: //')"
pmset -g | grep -q 'SleepDisabled[[:space:]]*1' && sl=active || sl="sleep is ON"
echo "never sleep $(ok "$sl")"
jobs=$(launchctl list | grep -c -E 'com\.box\.(t3-service-wrap|reap-convex-executors|reap-idle-dev-stacks|reap-stale-tmp|heartbeat)$')
[ "$jobs" = 5 ] && js=active || js="$jobs/5 loaded (run mac/install-macbox)"
echo "box jobs    $(ok "$js")"
[ "$(plutil -extract ProgramArguments.0 raw -o - ~/Library/LaunchAgents/com.t3tools.t3code.service.plist 2>/dev/null)" = "$HOME/.local/libexec/box-launch" ] && w=active || w="not wrapped: ~/Documents prompts return"
echo "t3 wrapped  $(ok "$w")"
# The heartbeat probes ~/Documents through box-launch every 30 min; SSH itself is exempt from the prompt.
grep -qx docs ~/.config/box/alerts 2>/dev/null && d="BLOCKED: click Allow in box desktop" || d=active
echo "~/Documents $(ok "$d")"
echo "battery     $(pmset -g batt | grep -o "[0-9]*%.*;" | head -1)"
free=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{print $2+0}')
echo "memory      $((100 - ${free:-100}))% used of $(( $(sysctl -n hw.memsize) / 1073741824 )) GB (swap $(sysctl -n vm.swapusage | awk '{print $6" / "$3}'))"
# "/" is the sealed system volume; files live on the Data volume.
echo "disk        $(df -h /System/Volumes/Data | awk 'NR==2{print $3" used / "$2}')"
EOF
    return
  fi
  on "$h" 'bash -s' <<'EOF'
ok() { [ "$1" = active ] && printf "\e[32m%s\e[0m" "$1" || printf "\e[31m%s\e[0m" "$1"; }
echo "uptime      $(uptime -p)"
echo "t3 code     $(ok $(systemctl --user is-active t3code))"
if [ -f ~/.cli-proxy-api/management-key ]; then
  echo "cliproxy    $(ok $(systemctl --user is-active cliproxyapi))"
  key=$(cat ~/.cli-proxy-api/management-key)
  echo "claude accts $(curl -s -H "Authorization: Bearer $key" http://127.0.0.1:24873/v0/management/auth-files | jq -r '[.files[] | "\(.email) (\(.status))"] | join(", ")')"
else
  base=$(jq -r ".env.ANTHROPIC_BASE_URL // empty" ~/.claude/settings.json 2>/dev/null)
  code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "$base/v1/models" -H "x-api-key: $(cat ~/.cli-proxy-api/proxy-key 2>/dev/null)")
  [ "$code" = 200 ] && st=active || st="unreachable ($code)"
  echo "claude via  $base $(ok "$st")"
fi
systemctl list-unit-files tailscaled.service >/dev/null 2>&1 && echo "tailscale   $(ok $(systemctl is-active tailscaled))"
systemctl --user list-unit-files gnome-remote-desktop.service 2>/dev/null | grep -q enabled && echo "remote desk $(ok $(systemctl --user is-active gnome-remote-desktop))"
[ -d /sys/class/power_supply/BAT0 ] && echo "battery     $(cat /sys/class/power_supply/BAT0/capacity)% $(cat /sys/class/power_supply/BAT0/status) (cap $(cat /sys/class/power_supply/BAT0/charge_control_end_threshold)%)"
echo "t3 connect  $(sh -lc 't3 connect status 2>/dev/null' | grep -E 'Exposure' | sed 's/.*: //')"
# T3's Chrome has its own AppArmor profile; the Playwright profile does not cover it.
if [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ]; then
  profile=t3-chrome-headless-shell
  profiles=$(cat /sys/kernel/security/apparmor/profiles 2>/dev/null || sudo -n cat /sys/kernel/security/apparmor/profiles 2>/dev/null)
  if ! grep -q 'userns,' "/etc/apparmor.d/$profile" 2>/dev/null || [ -e "/etc/apparmor.d/disable/$profile" ] ||
     { [ -n "$profiles" ] && ! printf '%s\n' "$profiles" | grep -q "^$profile "; }; then
    echo 't3 browser  NEEDS SETUP: sudo env "PATH=$PATH" t3 browser setup'
  else
    echo 't3 browser  AppArmor profile installed'
  fi
fi
echo "memory      $(free -h | awk '/Mem/{print $3" used / "$2} /Swap/{print "(swap "$3" / "$2")"}' | paste -sd' ')"
command -v sensors >/dev/null && echo "cpu temp    $(sensors 2>/dev/null | awk '/^Package id 0:/{print $4; exit}')"
echo "disk        $(df -h / | awk 'NR==2{print $3" used / "$2}')"
EOF
}

cmd_reboot() {
  need_box reboot || return 1
  local h; h=$(resolve) || return 1
  [[ $h == self ]] && { say "is this machine; reboot it from another one"; return 1; }
  say "rebooting..."
  if has_role $TARGET macbox; then on "$h" 'sudo shutdown -r now' 2>/dev/null; else on "$h" 'sudo systemctl reboot' 2>/dev/null; fi
  sleep 20
  for _ in {1..40}; do reachable "$h" 22 && break; sleep 3; done
  sleep 15
  cmd_status
}

cmd_logs() {
  need_box logs || return 1
  local unit=${1:-t3code} h; h=$(resolve) || return 1
  # launchd has no journal: the T3 service writes its own log file, the box jobs ~/Library/Logs/box.
  if has_role $TARGET macbox; then
    case $unit in
      t3code) ont "$h" 'tail -n 100 -f ~/.t3/userdata/logs/boot-service.log' ;;
      *) ont "$h" "tail -n 100 -f ~/Library/Logs/box/${unit#box-}.log" ;;
    esac
    return
  fi
  ont "$h" "journalctl --user -u $unit -n 100 -f"
}

cmd_claude_login() {
  need_role proxy "Claude accounts live on" claude-login || return 1
  local h; h=$(resolve) || return 1
  say "sign in on the page that opens in your browser"
  [[ $h == self ]] && { ~/.local/bin/cliproxyapi -config ~/.config/cliproxyapi/config.yaml -claude-login -no-browser; return; }
  ssh -t -L 54545:localhost:54545 "$USER_NAME@$h" '~/.local/bin/cliproxyapi -config ~/.config/cliproxyapi/config.yaml -claude-login -no-browser'
}

# Two-way sync of revnu2's Claude memories with every reachable machine; the newer copy of each file wins.
cmd_sync_memory() {
  local n h r synced=() mine="$HOME/$(memory_dir $SELF)"
  mkdir -p "$mine"
  for n in $FLEET; do
    [[ $n == $SELF ]] && continue
    TARGET=$n; r=$(memory_dir $n)
    h=$(resolve 2>/dev/null) || { say "unreachable, skipped"; continue; }
    on "$h" "mkdir -p ~/$r" || continue
    rsync -au "$mine" "$USER_NAME@$h:$r" && rsync -au "$USER_NAME@$h:$r" "$mine" && synced+=($n)
  done
  # Second pass so a newer file pulled from a later machine reaches the earlier ones too.
  for n in $synced; do TARGET=$n; h=$(resolve 2>/dev/null) && rsync -au "$mine" "$USER_NAME@$h:$(memory_dir $n)"; done
  TARGET=""
  say "memories synced with ${(j:, :)synced:-nothing} ($(ls "$mine" | grep -vc MEMORY.md) files)"
}

# Install skills/sync-skills (and its hourly timer) on every reachable machine and run it now,
# so the global bot-loop everywhere is revnu2 main's.
cmd_sync_skills() {
  local n h d="$BOX_REPO/skills" ok=()
  for n in $FLEET; do
    TARGET=$n; h=$(resolve 2>/dev/null) || { say "unreachable, skipped"; continue; }
    if [[ -r $d/sync-skills ]]; then
      on "$h" 'mkdir -p ~/.local/bin && cat > ~/.local/bin/sync-skills && chmod +x ~/.local/bin/sync-skills' < "$d/sync-skills" || continue
      if on_macos $n; then
        on "$h" 'p=~/Library/LaunchAgents/com.box.sync-skills.plist; t=$(mktemp); cat > "$t"
          if cmp -s "$t" "$p"; then rm "$t"; else mv "$t" "$p"
            launchctl bootout gui/$(id -u) "$p" 2>/dev/null; launchctl bootstrap gui/$(id -u) "$p"; fi' \
          < "$BOX_REPO/mac/com.box.sync-skills.plist"
      else
        on "$h" 'mkdir -p ~/.config/systemd/user && cat > ~/.config/systemd/user/sync-skills.service' < "$d/sync-skills.service"
        on "$h" 'cat > ~/.config/systemd/user/sync-skills.timer && systemctl --user daemon-reload && systemctl --user enable -q --now sync-skills.timer' < "$d/sync-skills.timer"
      fi
    fi
    on "$h" '~/.local/bin/sync-skills' && ok+=($n)
  done
  TARGET=""
  say "skills synced on ${(j:, :)ok:-nothing}"
}

# Search locally and over SSH. Only base64 data enters the remote shell command; both Python
# source and query are decoded by python3 -c, so quotes/metacharacters stay literal.
cmd_threads() {
  [[ $1 == search && -n ${2//[[:space:]]/} ]] || { say 'usage: box threads search <query>'; return 1; }
  shift
  local query="$*" encoded source n h
  encoded=$(printf %s "$query" | base64 | tr -d '\n')
  source=$(cat <<'PY' | base64 | tr -d '\n'
import base64
import json
import os
from pathlib import Path
import sqlite3
import sys

query = base64.b64decode(sys.argv[1]).decode().casefold()
machine = sys.argv[2]
root = Path(os.environ.get("T3CODE_HOME", str(Path.home() / ".t3")))
db = root / "userdata/statev2.sqlite"
threads, matches, sessions = {}, {}, {}


def snippet(text):
    text = " ".join(str(text).split())
    pos = text.casefold().find(query)
    start = max(0, pos - 60)
    return ("…" if start else "") + text[start:start + 200] + ("…" if len(text) > start + 200 else "")


def match(tid, text):
    if tid in threads and tid not in matches and query in str(text).casefold():
        matches[tid] = snippet(text)


if db.is_file():
    try:
        with sqlite3.connect(db.as_uri() + "?mode=ro", uri=True, timeout=5) as conn:
            conn.execute("PRAGMA query_only=ON")
            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            # Current records supersede imported legacy records, including deleted threads.
            for table in ("projection_threads", "orchestration_v2_projection_threads"):
                if table in tables:
                    for tid, title, deleted in conn.execute("SELECT thread_id,title,deleted_at FROM " + table):
                        threads[tid] = None if deleted else title
            threads = {tid: title for tid, title in threads.items() if title is not None}
            for tid, title in threads.items():
                match(tid, title)
            # Use a literal substring, not LIKE: % and _ in a query are ordinary text.
            conn.create_function("contains_query", 1, lambda value: query in (value or "").casefold())
            for table, column in (("orchestration_v2_projection_messages", "json_extract(payload_json, '$.text')"),
                                  ("projection_thread_messages", "text")):
                if table in tables:
                    for tid, text in conn.execute("SELECT thread_id," + column + " FROM " + table +
                                                  " WHERE contains_query(" + column + ") ORDER BY created_at DESC"):
                        match(tid, text)
            if "projection_thread_sessions" in tables:
                for tid, sid, native in conn.execute("SELECT thread_id,provider_session_id,provider_thread_id FROM projection_thread_sessions"):
                    for ref in (sid, native):
                        if ref:
                            sessions.setdefault(ref, set()).add(tid)
            if "orchestration_v2_projection_provider_threads" in tables:
                for tid, payload in conn.execute("SELECT thread_id,payload_json FROM orchestration_v2_projection_provider_threads"):
                    ref = (json.loads(payload).get("nativeThreadRef") or {}).get("nativeId")
                    if ref:
                        sessions.setdefault(ref, set()).add(tid)
    except (sqlite3.Error, ValueError) as exc:
        print(machine + ": T3 search failed: " + str(exc), file=sys.stderr)
        sys.exit(1)
else:
    print(machine + ": no T3 database at " + str(db), file=sys.stderr)

# Claude tool output can contain a match absent from T3's displayed messages. Search linked
# transcripts only, so every result still identifies a T3 thread rather than an unrelated CLI session.
for path in (Path.home() / ".claude/projects").glob("**/*.jsonl"):
    tids = sessions.get(path.stem, set()) - matches.keys()
    if not tids:
        continue
    try:
        with path.open(errors="replace") as transcript:
            for line in transcript:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                content = (event.get("message") or {}).get("content", "")
                text = content if isinstance(content, str) else json.dumps(content, ensure_ascii=False)
                if query in text.casefold():
                    for tid in tids:
                        match(tid, text)
                    break
    except OSError as exc:
        print(machine + ": cannot read transcript " + str(path) + ": " + str(exc), file=sys.stderr)

for tid in sorted(matches, key=lambda tid: (threads[tid].casefold(), tid)):
    # JSON quoting keeps terminal escapes, tabs and newlines in titles/snippets harmless.
    print("\t".join((machine, tid, json.dumps(threads[tid], ensure_ascii=False),
                     json.dumps(matches[tid], ensure_ascii=False))))
PY
  )
  printf 'MACHINE\tTHREAD ID\tTITLE\tSNIPPET\n'
  local failed=0 searched=0
  for n in $FLEET; do
    TARGET=$n; h=$(resolve 2>/dev/null) || { say 'unreachable, skipped'; continue; }
    on "$h" "python3 -c 'import base64; exec(base64.b64decode(\"$source\"))' '$encoded' '$n'" \
      && (( searched += 1 )) || failed=1
  done
  TARGET=""
  (( searched )) || { say 'no machine could be searched'; return 1; }
  return $failed
}

cmd_update() {
  need_box update || return 1
  local h; h=$(resolve) || return 1
  # macOS box: no apt; Codex is an npm global there, and `t3 update` restarts its own launchd service
  # (com.box.t3-service-wrap then puts box-launch back in front of it). install-macbox refreshes the
  # heartbeat and reapers.
  has_role $TARGET macbox && { ont "$h" 'git -C ~/Documents/projects/box pull -q --ff-only; t3 update --yes; claude update; npm i -g @openai/codex@latest; bun upgrade; if [ -f "$HOME/.local/share/box/heavy-check-install.json" ]; then python3 ~/Documents/projects/box/bin/install-heavy-checks; fi; ~/Documents/projects/box/mac/install-macbox'; return; }
  ont "$h" 'git -C ~/Documents/projects/box pull -q --ff-only; sudo apt-get update -qq && sudo apt-get upgrade -y && sh -lc "t3 update --yes; claude update; codex update; bun upgrade; if [ -f \"\$HOME/.local/share/box/heavy-check-install.json\" ]; then python3 ~/Documents/projects/box/bin/install-heavy-checks; fi" && systemctl --user restart t3code'
}

# What each machine is for, shown in `box help`.
describe() {
  if has_role $1 mac; then echo "Art's MacBook, the main machine. Art works here; be careful with it."
  elif has_role $1 windows; then echo "Art's Windows PC; SSH only when it's on, no T3 or agents, skipped by \"all\" and syncs"
  elif has_role $1 proxy; then echo "agent box (Ubuntu), the default; holds the Claude accounts (CLIProxyAPI)"
  elif has_role $1 macbox; then echo "agent box (macOS); Claude goes through skynet's proxy"
  else echo "agent box (Ubuntu); Claude goes through skynet's proxy"; fi
}

cmd_help() {
  local n
  cat <<EOF
These are Art's machines. All of them can reach each other, and every one but the Windows PC has this CLI:

EOF
  for n in $M_NAMES; do printf "  %-8s %s%s\n" $n "$(describe $n)" "$([[ $n == $SELF ]] && echo '  <- you are here')"; done
  cat <<EOF

The MacBook is the master: it's where Art works, and the boxes do the long-running agent work.
Reach any machine from any other, home network first and Tailscale otherwise:
  ssh <machine>                 plain SSH (e.g. ssh jarvis), key-based, no password
  box <machine>                 a shell that survives disconnects (tmux "main")
  box run <machine> <cmd>       one command, e.g. box run jarvis 'nproc; free -g'

Commands ([machine] defaults to $(machine_with_role default); "all" means every machine):
  box list                      every machine and whether it's reachable right now
  box status [machine|all]      health check: services, Claude, browser sandbox, battery, disk
  box logs [machine] [unit]     follow logs: t3code (default), cliproxyapi, gnome-remote-desktop, reapers/heartbeat
  box update [machine|all]      update Ubuntu (not macOS), T3 Code, Claude Code, Codex, bun, and this CLI
  box reboot [machine]          reboot and wait until it's back (kills its running agent threads)
  box threads search <query>    search T3 titles, messages and Claude transcripts on every machine
  box sync-memory               two-way sync of revnu2 Claude memories with every machine
  box sync-skills               install bot-loop from revnu2 main on every machine (also runs hourly)
  box usage                     5-hour and weekly use per Claude account
  box claude-login              add or re-auth a Claude account in the proxy (needs Art in a browser)
  box desktop [machine]         a box's desktop (RDP, or Screen Sharing on air), or the Windows PC's screen (Mac only)
  box proxy | proxy-close       CLIProxyAPI dashboard (Mac only)

Machines are listed in ${MACHINES_FILE:A}. Full notes: ${MACHINES_FILE:A:h}/docs/machines.md
EOF
}

# `box jarvis status` and `box status jarvis` both work; with no machine named, the default is used.
args=("$@")
if is_machine "${args[1]}"; then TARGET=${args[1]}; args=("${args[@]:1}"); fi
cmd=${args[1]:-ssh}; args=("${args[@]:1}")
ALL=0
if [[ -z $TARGET ]] && is_machine "${args[1]}"; then TARGET=${args[1]}; args=("${args[@]:1}")
elif [[ -z $TARGET && ${args[1]} == all ]]; then ALL=1; args=("${args[@]:1}"); fi
case $cmd in proxy|p|proxy-close|claude-login|usage|u) TARGET=${TARGET:-$(machine_with_role proxy)} ;; esac
TARGET=${TARGET:-$(machine_with_role default)}

each() { if (( ALL )); then for TARGET in $FLEET; do "$@"; echo; done; else "$@"; fi; }

case $cmd in
  ssh|"") cmd_ssh ;;
  list|ls|-l|-list|--list) cmd_list ;;
  desktop|rdp|d) cmd_desktop "${args[1]}" ;;
  proxy|p) cmd_proxy ;;
  proxy-close) cmd_proxy_close ;;
  status|s) each cmd_status ;;
  run) run "${args[@]}" ;;
  logs|l) cmd_logs "${args[1]}" ;;
  claude-login) cmd_claude_login ;;
  usage|u) cmd_usage ;;
  update) each cmd_update ;;
  threads) cmd_threads "${args[@]}" ;;
  sync-memory) cmd_sync_memory ;;
  sync-skills) cmd_sync_skills ;;
  reboot) cmd_reboot ;;
  help|-h|--help) cmd_help ;;
  *) say "unknown command: $cmd"; cmd_help; exit 1 ;;
esac
