#!/usr/bin/env python3
"""Small, per-user queue for memory-heavy commands. No daemon or dependencies."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import signal
import sqlite3
import subprocess
import sys
import time
import uuid
import re
import shlex

ROOT = Path(os.environ.get("HEAVY_CHECK_STATE", Path.home() / ".local/state/box/heavy-check")).absolute()
CONFIG = Path(os.environ.get("HEAVY_CHECK_CONFIG", Path.home() / ".config/box/heavy-check.json")).absolute()
DEFAULTS = {"slots": 2, "reserve_gib": 6, "headroom_gib": 4, "idle_gib": 6}
STOP = None
SIGNALS = {signal.SIGINT, signal.SIGTERM}
HEARTBEAT = 30
DEFAULT_MAX_WAIT = 900
# A worker's own timeout writes the useful message; reap is only the backstop for
# workers that can't (older installs, wedged processes).
REAP_GRACE = 60
BOOT = None
MEMORY_NOTE = ""


def settings():
    config = DEFAULTS | (json.loads(CONFIG.read_text()) if CONFIG.exists() else {})
    if not isinstance(config["slots"], int) or not 1 <= config["slots"] <= 32:
        raise ValueError("slots must be an integer from 1 to 32")
    for key in ("reserve_gib", "headroom_gib", "idle_gib"):
        if not isinstance(config[key], (int, float)) or config[key] < 0:
            raise ValueError(f"{key} must be a nonnegative number")
    return config


def max_wait(env):
    """Seconds a job may wait for admission, or None for no limit."""
    raw = env.get("HEAVY_CHECK_MAX_WAIT", "").strip().lower()
    if not raw:
        return DEFAULT_MAX_WAIT
    match = re.fullmatch(r"(\d+(?:\.\d+)?)([smh]?)", raw)
    if not match:
        raise ValueError(f"HEAVY_CHECK_MAX_WAIT={raw!r}: use seconds, or a number ending in s, m or h (0 = no limit)")
    seconds = float(match.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[match.group(2)]
    return seconds or None


def duration(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def available_gib():
    global MEMORY_NOTE
    if sys.platform == "darwin":
        # 1 normal, 2 warn, 4 critical. A busy Mac sits at warn for hours, and the page
        # count below already shrinks then, so only critical pauses admission.
        pressure = subprocess.check_output(["sysctl", "-n", "kern.memorystatus_vm_pressure_level"], text=True).strip()
        MEMORY_NOTE = {"1": "", "2": "macOS memory pressure: warn"}.get(pressure, "macOS memory pressure: critical")
        if pressure not in ("1", "2"):
            return 0
        stats = subprocess.check_output(["vm_stat"], text=True)
        page_size = int(re.search(r"page size of (\d+) bytes", stats).group(1))
        pages = sum(int(re.search(rf"{label}:\s+(\d+)", stats).group(1))
                    for label in ("Pages free", "Pages inactive", "Pages speculative"))
        return pages * page_size / 1073741824
    if sys.platform != "linux":
        raise RuntimeError("heavy-check supports Linux and macOS")
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) / 1048576
    raise RuntimeError("MemAvailable missing from /proc/meminfo")


def identity(pid):
    """Include boot ID and process start time so recycled PIDs are not owners."""
    global BOOT
    if sys.platform == "darwin":
        if BOOT is None:
            BOOT = subprocess.check_output(["sysctl", "-n", "kern.boottime"], text=True).strip()
        result = subprocess.run(["ps", "-p", str(pid), "-o", "stat=", "-o", "lstart="],
                                text=True, capture_output=True, timeout=5)
        fields = result.stdout.strip().split(None, 1)
        if result.returncode or len(fields) != 2 or fields[0].startswith("Z"):
            return None
        return BOOT + ":" + fields[1]
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        if fields[0] == "Z":
            return None
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip() + ":" + fields[19]
    except (OSError, IndexError):
        return None


def identities(pids):
    """identity() for many PIDs: one ps call on macOS rather than one per PID per poll."""
    pids = sorted({pid for pid in pids if pid})
    if sys.platform != "darwin" or not pids:
        return {pid: identity(pid) for pid in pids}
    global BOOT
    if BOOT is None:
        BOOT = subprocess.check_output(["sysctl", "-n", "kern.boottime"], text=True).strip()
    # All processes, not -p: one out-of-range PID makes macOS ps print nothing at all.
    result = subprocess.run(["ps", "-ax", "-o", "pid=", "-o", "stat=", "-o", "lstart="],
                            text=True, capture_output=True, timeout=5)
    found = {pid: None for pid in pids}
    for line in result.stdout.splitlines():
        fields = line.split(None, 2)
        if len(fields) == 3 and fields[0].isdigit() and not fields[1].startswith("Z"):
            found[int(fields[0])] = BOOT + ":" + fields[2].rstrip()
    return found


@contextlib.contextmanager
def database():
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    db = sqlite3.connect(ROOT / "queue.sqlite", timeout=30, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA busy_timeout=30000")
    db.execute("""CREATE TABLE IF NOT EXISTS jobs (
        id TEXT PRIMARY KEY, created REAL, cwd TEXT, command TEXT,
        state TEXT, owner INTEGER, identity TEXT, pgid INTEGER,
        child_identity TEXT, started REAL, finished REAL, code INTEGER,
        cancel INTEGER DEFAULT 0)""")
    db.execute("BEGIN IMMEDIATE")
    try:
        # Migrate queues created by older installed runners under the same lock.
        columns = {row[1] for row in db.execute("PRAGMA table_info(jobs)")}
        for name, kind in {"uid": "INTEGER", "submitter": "INTEGER", "environment": "TEXT", "cancel_reason": "TEXT",
                           "cancel_pid": "INTEGER", "cancel_signal": "INTEGER",
                           "cancel_at": "REAL", "recovery_reason": "TEXT", "caller_identity": "TEXT"}.items():
            if name not in columns:
                db.execute(f"ALTER TABLE jobs ADD COLUMN {name} {kind}")
        yield db
        db.execute("COMMIT")
    except BaseException:
        db.execute("ROLLBACK")
        raise
    finally:
        db.close()


def reap(db):
    jobs = db.execute("SELECT * FROM jobs WHERE state IN ('queued','running')").fetchall()
    alive = identities([pid for job in jobs for pid in (job["owner"], job["submitter"], job["pgid"])])
    now = time.time()
    for job in jobs:
        # Only foreground `run` records its caller; nobody reads a job whose caller
        # is gone, so it must not keep its place in line or its slot.
        if (job["caller_identity"] and not job["cancel"]
                and alive.get(job["submitter"]) != job["caller_identity"]):
            request_cancel(db, job["id"], f"caller pid={job['submitter']} exited while the job was {job['state']}; "
                           "nobody is waiting for it, so it was cancelled to free the line")
            job = db.execute("SELECT * FROM jobs WHERE id=?", (job["id"],)).fetchone()
        if job["state"] == "queued" and not job["cancel"]:
            try:
                limit = max_wait(json.loads(job["environment"]) if job["environment"] else {})
            except ValueError:
                limit = DEFAULT_MAX_WAIT
            if limit and job["created"] and now - job["created"] > limit + REAP_GRACE:
                request_cancel(db, job["id"], f"waited {duration(now - job['created'])} in the queue, past its "
                               f"max wait of {duration(limit)} (HEAVY_CHECK_MAX_WAIT)")
                job = db.execute("SELECT * FROM jobs WHERE id=?", (job["id"],)).fetchone()
        current = alive.get(job["owner"])
        if current is not None and current == job["identity"]:
            continue
        if job["state"] == "queued" and job["cancel"]:
            db.execute("UPDATE jobs SET state='cancelled',code=130,finished=? WHERE id=?", (now, job["id"]))
            continue
        if job["state"] == "queued":
            reason = f"queued worker pid={job['owner']} disappeared (signal/sender unknown); restarted"
            db.execute("UPDATE jobs SET recovery_reason=? WHERE id=?", (reason, job["id"]))
            launch(db, job["id"])
            continue
        # If the supervisor was SIGKILLed, kill its still-identifiable child group.
        # The child inherits the slot lock, so a surviving command never frees capacity.
        if job["pgid"] and alive.get(job["pgid"]) == job["child_identity"]:
            signal_group(job["pgid"], signal.SIGKILL)
        reason = f"running worker pid={job['owner']} disappeared (signal/sender unknown)"
        db.execute("""UPDATE jobs SET state='lost',finished=?,code=125,
            cancel_reason=COALESCE(cancel_reason,?),recovery_reason=? WHERE id=?""",
                   (time.time(), reason, reason, job["id"]))


def nested():
    job_id = os.environ.get("HEAVY_CHECK_JOB")
    if not job_id:
        return False
    with database() as db:
        job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
        return bool(job and job["state"] == "running" and job["pgid"] == os.getpgrp())


VALUE_FLAGS = {"--cwd", "-C", "--filter", "--env-file", "--config", "-c", "--preload", "-r",
               "--timeout", "--test-name-pattern", "-t", "--reporter", "--reporter-outfile",
               "--coverage-reporter", "--coverage-dir", "--concurrent", "--max-concurrency"}


def positional(args):
    result = []
    iterator = iter(args)
    for arg in iterator:
        if arg == "--":
            result.extend(iterator)
            break
        if arg in VALUE_FLAGS:
            next(iterator, None)
        elif not arg.startswith("-"):
            result.append(arg)
    return result


def self_queued(args, script):
    """A project lists scripts that validate their own arguments and then call
    `heavy-check run` themselves, so a usage error never waits for a slot."""
    directory = Path(os.getcwd())
    for flag in ("--cwd", "-C"):
        if flag in args[:-1]:
            directory = directory / args[args.index(flag) + 1]
    for folder in (directory, *directory.parents):
        package = folder / "package.json"
        if package.is_file():
            try:
                listed = json.loads(package.read_text()).get("heavyCheck", {}).get("selfQueued", [])
            except (OSError, ValueError, AttributeError):
                return False
            return isinstance(listed, list) and script in listed
    return False


def heavy_bun(args):
    """Recognize full checks without requiring each checkout to carry wrappers."""
    if any(arg in ("--help", "-h", "--version", "-v") for arg in args):
        return False
    words = positional(args)
    if not words:
        return False
    command = words[0]
    if command == "run":
        if len(words) > 1 and self_queued(args, words[1]):
            return False
        return len(words) > 1 and words[1].split(":", 1)[0] in {"check", "typecheck", "build", "test"}
    if command == "test":
        # A named file or test-name filter is a targeted test; let it run freely.
        return len(words) == 1 and not any(arg == "-t" or arg.startswith("--test-name-pattern") for arg in args)
    if command == "x":
        return len(words) > 1 and words[1].split("@", 1)[0] == "tsc"
    return command.split(":", 1)[0] in {"check", "typecheck", "build", "test"}


def stop(signum, frame):
    global STOP
    STOP = (signum, None)


def watch_signals():
    for signum in SIGNALS:
        signal.signal(signum, stop)
    # Linux exposes siginfo, including the sending PID. Darwin's Python signal
    # handler only supplies the number, so leave the sender explicitly unknown.
    if hasattr(signal, "sigtimedwait"):
        signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)


def pending_signal():
    global STOP
    if hasattr(signal, "sigtimedwait"):
        info = signal.sigtimedwait(SIGNALS, 0)
        if info is not None:
            return info.si_signo, info.si_pid or None
    result, STOP = STOP, None
    return result


def unblock_signals():
    # Popen children must not inherit our sigtimedwait mask.
    signal.pthread_sigmask(signal.SIG_UNBLOCK, SIGNALS)


def signal_reason(event, recipient):
    signum, sender = event
    return (f"signal {signum} ({signal.Signals(signum).name}) to {recipient}; "
            f"sender pid={sender if sender is not None else 'unknown'}")


def request_cancel(db, job_id, reason, pid=None, signum=None):
    # Preserve the first request if a signal races an explicit cancel.
    db.execute("""UPDATE jobs SET cancel=1,cancel_reason=?,cancel_pid=?,cancel_signal=?,cancel_at=?
        WHERE id=? AND cancel=0 AND state IN ('queued','running')""",
               (reason, pid, signum, time.time(), job_id))


def launch(db, job_id, foreground=False):
    job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
    env = json.loads(job["environment"]) if job["environment"] else os.environ.copy()
    env.update(HEAVY_CHECK_STATE=str(ROOT), HEAVY_CHECK_CONFIG=str(CONFIG))
    with open(ROOT / f"{job_id}.log", "ab", buffering=0) as log:
        with open(ROOT / f"{job_id}.stdout", "ab", buffering=0) as output:
            child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_work", job_id],
                                     stdin=None if foreground else subprocess.DEVNULL,
                                     stdout=output, stderr=log, start_new_session=True,
                                     preexec_fn=unblock_signals, env=env)
            if job["recovery_reason"]:
                log.write(f"[heavy-check {job_id}] {job['recovery_reason']}; worker pid={child.pid}\n".encode())
    db.execute("UPDATE jobs SET owner=?,identity=? WHERE id=?", (child.pid, identity(child.pid), job_id))
    return child


def describe(job, now):
    """One holder or waiter, short enough to read in a progress line."""
    command = json.loads(job["command"])
    words = [Path(command[0]).name.removesuffix(".heavy-check-original")]
    for word in command[1:]:
        if word == "--no-env-file":
            continue
        words.append(os.path.relpath(word, job["cwd"]) if word.startswith(job["cwd"] + "/") else word)
    text = shlex.join(words)
    text = text if len(text) <= 60 else text[:57] + "..."
    if job["state"] == "running":
        age = f"running {duration(now - job['started'])}"
    else:
        age = f"queued {duration(now - job['created'])}"
    return f"{job['id']} {age} in {Path(job['cwd']).name} ({text})"


def queue_notice(db, job, config, available, required, now, limit):
    queued = db.execute("SELECT * FROM jobs WHERE state='queued' ORDER BY created,id").fetchall()
    running = db.execute("SELECT * FROM jobs WHERE state='running' ORDER BY started,id").fetchall()
    eligible = [q for q in queued if not any(r["cwd"] == q["cwd"] for r in running)]
    position = next(i + 1 for i, q in enumerate(queued) if q["id"] == job["id"])
    gates = []
    if any(r["cwd"] == job["cwd"] for r in running):
        gates.append("same cwd already running")
    if any(q["id"] == job["id"] for q in eligible) and eligible[0]["id"] != job["id"]:
        gates.append("eligible jobs ahead")
    if len(running) >= config["slots"]:
        gates.append(f"slots full ({len(running)}/{config['slots']})")
    if available < required:
        gates.append("memory")
    ahead = [*running, *queued[:position - 1]]
    snapshot = (position, tuple(other["id"] for other in ahead), tuple(gates))
    memory = f"memory {available:.1f} GiB free, {required:.1f} GiB needed" + (f" ({MEMORY_NOTE})" if MEMORY_NOTE else "")
    waited = now - job["created"]
    deadline = (f"gives up in {duration(max(0, limit - waited))} (HEAVY_CHECK_MAX_WAIT={limit:g}s)" if limit
                else "no max wait (HEAVY_CHECK_MAX_WAIT=0)")
    line = (f"waiting {duration(waited)}; place {position} of {len(queued)} queued; "
            f"ahead: {'; '.join(describe(other, now) for other in ahead) or 'nobody'}; "
            f"{memory}; blocked by: {', '.join(gates) or 'nothing, starting'}; {deadline}")
    return snapshot, line, ahead


def timeout_message(ahead, line, limit, now):
    holders = "\n".join(f"  {describe(other, now)}" for other in ahead) or "  nobody (memory alone kept it out)"
    return (f"gave up after waiting {duration(limit)} in the heavy-check queue; the command never started.\n"
            f"Last state: {line}\nAhead of it:\n{holders}\n"
            "To wait longer: HEAVY_CHECK_MAX_WAIT=30m (or 0 for no limit) before the command. "
            "To see the queue: heavy-check status.")


def wait_for_job(job_id, child):
    watch_signals()
    # Separate files preserve stdout/stderr and allow a recovered worker to append.
    with open(ROOT / f"{job_id}.stdout", "rb") as output, open(ROOT / f"{job_id}.log", "rb") as log:
        last_reap = 0
        while True:
            with database() as db:
                if time.monotonic() - last_reap >= 1:
                    reap(db)
                    last_reap = time.monotonic()
                event = pending_signal()
                if event:
                    request_cancel(db, job_id, signal_reason(event, f"caller pid={os.getpid()}"),
                                   event[1], event[0])
                job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
            for source, target in ((output, sys.stdout.buffer), (log, sys.stderr.buffer)):
                data = source.read()
                if data:
                    target.write(data)
                    target.flush()
            child.poll()  # Reap our worker; recovered workers may have another parent.
            if job["finished"] is not None:
                if job["state"] == "lost":
                    print(f"[heavy-check {job_id}] lost (exit 125): {job['cancel_reason']}",
                          file=sys.stderr, flush=True)
                return job["code"] if job["code"] is not None else 125
            time.sleep(0.25)


def signal_group(pgid, signum):
    try:
        os.killpg(pgid, signum)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        # Darwin can report EPERM, rather than ESRCH, for an exiting zombie group.
        # Do not suppress permission failures if the group still has live members.
        if sys.platform == "darwin":
            rows = subprocess.check_output(["ps", "-axo", "pgid=,stat="], text=True)
            members = [line.split() for line in rows.splitlines()]
            if not any(int(row[0]) == pgid and not row[1].startswith("Z") for row in members if len(row) == 2):
                return False
        raise


def group_exists(pgid):
    return signal_group(pgid, 0)


def terminate(child):
    if not signal_group(child.pid, signal.SIGTERM):
        return
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        child.poll()
        if not group_exists(child.pid):
            break
        time.sleep(0.05)
    signal_group(child.pid, signal.SIGKILL)
    child.wait()


def work(job_id):
    watch_signals()
    with database() as db:
        job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
        # A launch whose transaction rolled back must not execute the job.
        if not job or job["owner"] != os.getpid() or job["state"] != "queued":
            return 125
    child = None
    slot = None
    state, code = "failed", 125
    failure_reason = ""
    try:
        limit = max_wait(os.environ)
        last_notice, last_snapshot = None, None
        while child is None:
            config = settings()
            with database() as db:
                reap(db)
                job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
                event = pending_signal()
                if event:
                    # A worker/supervisor shutdown is not a caller's cancellation.
                    reason = signal_reason(event, f"queued worker pid={os.getpid()}") + "; queued job retained"
                    db.execute("UPDATE jobs SET recovery_reason=? WHERE id=?", (reason, job_id))
                    print(f"[heavy-check {job_id}] {reason}", file=sys.stderr, flush=True)
                if job["cancel"]:
                    state, code = "cancelled", 130
                    break
                first = db.execute("""SELECT q.id FROM jobs q WHERE q.state='queued'
                    AND NOT EXISTS (SELECT 1 FROM jobs r WHERE r.state='running' AND r.cwd=q.cwd)
                    ORDER BY q.created,q.id LIMIT 1""").fetchone()
                running = db.execute("SELECT COUNT(*) FROM jobs WHERE state='running'").fetchone()[0]
                # Account for a newly admitted job before its RSS has grown.
                young = db.execute("SELECT COUNT(*) FROM jobs WHERE state='running' AND started>?", (time.time() - 10,)).fetchone()[0]
                available = available_gib()
                # With no queued job running, nothing else of ours can grow into the headroom,
                # so the lone job only needs its own working memory.
                required = (config["headroom_gib"] + config["reserve_gib"] * (1 + young) if running
                            else config["idle_gib"])
                enough = available >= required
                same_checkout = db.execute("SELECT 1 FROM jobs WHERE state='running' AND cwd=?", (job["cwd"],)).fetchone()
                if first and first["id"] == job_id and enough and not same_checkout and running < config["slots"]:
                    # The count above is the real limit. The lock files only keep workers from
                    # older installs, which count by lock, from over-admitting beside us; a lock
                    # held by a stray process must not stop the line.
                    for number in range(config["slots"]):
                        candidate = open(ROOT / f"slot-{number}.lock", "a+")
                        try:
                            fcntl.flock(candidate, fcntl.LOCK_EX | fcntl.LOCK_NB)
                            slot = candidate
                            break
                        except BlockingIOError:
                            candidate.close()
                    if slot is None:
                        print(f"[heavy-check {job_id}] every slot lock is held but only {running} of "
                              f"{config['slots']} jobs run; ignoring stray lock holders", file=sys.stderr, flush=True)
                    env = os.environ | {"HEAVY_CHECK_JOB": job_id, "HEAVY_CHECK_STATE": str(ROOT)}
                    # The lock stays with this worker: a daemon the command leaves behind
                    # must not inherit it and hold the slot after the job ends.
                    child = subprocess.Popen(json.loads(job["command"]), cwd=job["cwd"], env=env,
                                             start_new_session=True, preexec_fn=unblock_signals)
                    db.execute("UPDATE jobs SET state='running',pgid=?,child_identity=?,started=? WHERE id=?",
                               (child.pid, identity(child.pid), time.time(), job_id))
                if child is None:
                    now = time.time()
                    snapshot, line, ahead = queue_notice(db, job, config, available, required, now, limit)
                    if limit and now - job["created"] >= limit:
                        state, code = "timeout", 124
                        failure_reason = timeout_message(ahead, line, limit, now)
                        break
                    if (last_notice is None or snapshot != last_snapshot
                            or time.monotonic() - last_notice >= HEARTBEAT):
                        print(f"[heavy-check {job_id}] {line}", file=sys.stderr, flush=True)
                        last_notice, last_snapshot = time.monotonic(), snapshot
            if child is None:
                time.sleep(1)
        if child is not None:
            print(f"[heavy-check {job_id}] running", file=sys.stderr, flush=True)
            while True:
                with database() as db:
                    event = pending_signal()
                    if event:
                        request_cancel(db, job_id, signal_reason(event, f"running worker pid={os.getpid()}"),
                                       event[1], event[0])
                    cancelled = db.execute("SELECT cancel FROM jobs WHERE id=?", (job_id,)).fetchone()[0]
                if cancelled:
                    terminate(child)
                    state, code = "cancelled", 130
                    break
                result = child.poll()
                if result is not None:
                    # Commands must not leave background children occupying memory.
                    terminate(child)
                    code = result if result >= 0 else 128 - result
                    state = "done" if code == 0 else "failed"
                    if result < 0:
                        failure_reason = signal_reason((-result, None), f"command pid={child.pid}")
                    break
                time.sleep(0.25)
    except (OSError, ValueError, RuntimeError) as error:
        failure_reason = f"worker error: {error}"
    finally:
        if child is not None and child.poll() is None:
            terminate(child)
        with database() as db:
            job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
            if job["cancel"]:
                state, code = "cancelled", 130
            reason = job["cancel_reason"] or failure_reason or ("legacy cancel request; sender unknown" if job["cancel"] else "")
            print(f"[heavy-check {job_id}] {state} (exit {code})" + (f": {reason}" if reason else ""),
                  file=sys.stderr, flush=True)
            db.execute("UPDATE jobs SET state=?,code=?,finished=?,cancel_reason=? WHERE id=?",
                       (state, code, time.time(), reason or None, job_id))
        if slot is not None:
            slot.close()
    return code


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["run", "submit", "status", "logs", "cancel", "_work", "bun"])
    parser.add_argument("args", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.action == "bun":
        command = args.args[1:] if args.args[:1] == ["--"] else args.args
        if not command:
            parser.error("bun dispatcher requires the original executable")
        if not heavy_bun(command[1:]):
            os.execv(command[0], command)
        args.action, args.args = "run", command
    settings()
    if args.action == "_work":
        return work(args.args[0])
    if args.action in ("run", "submit"):
        command = args.args[1:] if args.args[:1] == ["--"] else args.args
        if not command:
            parser.error("supply a command after --")
        if args.action == "run" and nested():
            os.execvpe(command[0], command, os.environ)
        max_wait(os.environ)  # A bad value fails here, not after queueing.
        watch_signals()
        job_id = uuid.uuid4().hex[:12]
        caller = identity(os.getpid())
        with database() as db:
            reap(db)
            db.execute("""INSERT INTO jobs (id,created,cwd,command,state,owner,identity,uid,submitter,environment,
                caller_identity) VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                       (job_id, time.time(), os.getcwd(), json.dumps(command), "queued", os.getpid(),
                        caller, os.getuid(), os.getpid(), json.dumps(dict(os.environ)),
                        caller if args.action == "run" else None))
            child = launch(db, job_id, foreground=args.action == "run")
        print(f"[heavy-check {job_id}] queued id={job_id} pid={child.pid} caller={os.getpid()} cwd={os.getcwd()}",
              file=sys.stderr, flush=True)
        if args.action == "submit":
            print(job_id)
            return 0
        return wait_for_job(job_id, child)
    with database() as db:
        reap(db)
        if args.action == "status":
            jobs = [dict(row) for row in db.execute("SELECT * FROM jobs ORDER BY created DESC LIMIT 50")]
            for job in jobs:
                job.pop("environment", None)
            if args.args == ["--json"]:
                print(json.dumps(jobs))
            else:
                print("ID            STATE       EXIT  PID / COMMAND / DIRECTORY / REASON")
                for job in jobs:
                    print(f"{job['id']}  {job['state']:<10}  {str(job['code']):<4}  "
                          f"worker={job['owner']} child={job['pgid']} / {shlex.join(json.loads(job['command']))} / "
                          f"{job['cwd']} / {job['cancel_reason'] or job['recovery_reason'] or ''}")
            return 0
        if args.action == "cancel":
            cancel_parser = argparse.ArgumentParser(prog="heavy-check cancel",
                description="Cancel jobs owned by this Unix user in the current working directory.")
            target = cancel_parser.add_mutually_exclusive_group()
            target.add_argument("job_id", nargs="?")
            target.add_argument("--id")
            target.add_argument("--pid", type=int)
            selection = cancel_parser.parse_args(args.args)
            jobs = db.execute("SELECT * FROM jobs WHERE cwd=? AND (uid=? OR uid IS NULL)",
                              (os.getcwd(), os.getuid())).fetchall()
            job_id = selection.id or selection.job_id
            if job_id:
                jobs = [job for job in jobs if job["id"] == job_id]
            elif selection.pid is not None:
                jobs = [job for job in jobs if selection.pid in (job["owner"], job["pgid"])
                        and job["state"] in ("queued", "running")
                        and identity(selection.pid) == (job["child_identity"] if selection.pid == job["pgid"]
                                                        else job["identity"])]
            if (job_id or selection.pid is not None) and not jobs:
                cancel_parser.error("no matching job owned by you in this cwd; run cancel from its directory")
            for job in jobs:
                if job["state"] not in ("queued", "running"):
                    continue
                reason = f"cancel verb by pid={os.getpid()} uid={os.getuid()} cwd={os.getcwd()}"
                request_cancel(db, job["id"], reason, os.getpid())
                print(f"Cancellation requested for {job['id']} pid={job['owner']}: {reason}")
            return 0
        if len(args.args) != 1:
            parser.error("supply one job ID")
        job_id = args.args[0]
        job = db.execute("SELECT * FROM jobs WHERE id=?", (job_id,)).fetchone()
        if not job:
            parser.error("unknown job ID")
    log = ROOT / f"{job_id}.log"
    if not log.exists():
        parser.error("no log file for this job (older foreground jobs only streamed to their caller)")
    sys.stdout.write((ROOT / f"{job_id}.stdout").read_text(errors="replace")
                     if (ROOT / f"{job_id}.stdout").exists() else "")
    sys.stdout.write(log.read_text(errors="replace"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError) as error:
        print(f"heavy-check: {error}", file=sys.stderr)
        sys.exit(125)
