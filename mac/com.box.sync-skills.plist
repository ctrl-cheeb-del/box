<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every hour: ~/.local/bin/sync-skills, which copies bot-loop from revnu2 main into
     ~/.claude/skills. Install: see README. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.box.sync-skills</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string><string>$HOME/.local/bin/sync-skills</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/box-sync-skills.log</string>
  <key>StandardErrorPath</key><string>/tmp/box-sync-skills.log</string>
</dict>
</plist>
